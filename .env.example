# Admin password for the Digital Culture Box admin panel.
# Vite exposes any variable prefixed with VITE_ to client code.
VITE_ADMIN_PASSWORD=your_password_here

# Google Maps JavaScript API key (requires Maps JavaScript API + Places API enabled).
# Obtain from https://console.cloud.google.com/google/maps-apis/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
